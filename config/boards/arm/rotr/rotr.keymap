/*
 * TEST BUILD for keyboard's PLAN-chapter2.md action 3. Not the real layout.
 * Tries: flashes while the wheel turns; waiting for release; left+right held
 * as one state; a three-key hold; scroll keys at two speeds.
 * The three-key hold only shows a rainbow here; it does NOT clear Bluetooth.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

&inc_dec_kp {
	triggers-per-rotation = <4>;
};

/ {
	behaviors {
		scroll_fast: scroll_fast {
			compatible = "zmk,behavior-sensor-rotate-key-press";
			label = "SCROLL_FAST";
			#sensor-binding-cells = <2>;
			triggers-per-rotation = <16>;
		};
		ht_l: ht_l {
			compatible = "zmk,behavior-hold-tap";
			label = "HT_L";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&hold_l>, <&kp>;
		};
		ht_m: ht_m {
			compatible = "zmk,behavior-hold-tap";
			label = "HT_M";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&hold_m>, <&kp>;
		};
		ht_r: ht_r {
			compatible = "zmk,behavior-hold-tap";
			label = "HT_R";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			bindings = <&hold_r>, <&kp>;
		};
		ht_all: ht_all {
			compatible = "zmk,behavior-hold-tap";
			label = "HT_ALL";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <3000>;
			bindings = <&rainbow>, <&none>;
		};
	};

	macros {
		hold_l: hold_l {
			compatible = "zmk,behavior-macro";
			label = "HOLD_L";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_press &mo 1>
				, <&macro_tap &rgb_ug RGB_EFS_CMD 0 &rgb_ug RGB_COLOR_HSB(120,40,50)>
				, <&macro_wait_time 120>
				, <&macro_tap &rgb_ug RGB_ON &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_OFF>
				, <&macro_pause_for_release>
				, <&macro_release &mo 1>
				;
		};
		hold_m: hold_m {
			compatible = "zmk,behavior-macro";
			label = "HOLD_M";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_press &mo 2>
				, <&macro_tap &rgb_ug RGB_EFS_CMD 0 &rgb_ug RGB_COLOR_HSB(35,100,50)>
				, <&macro_wait_time 120>
				, <&macro_tap &rgb_ug RGB_ON &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_OFF>
				, <&macro_pause_for_release>
				, <&macro_release &mo 2>
				;
		};
		hold_r: hold_r {
			compatible = "zmk,behavior-macro";
			label = "HOLD_R";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_press &mo 3>
				, <&macro_tap &rgb_ug RGB_EFS_CMD 0 &rgb_ug RGB_COLOR_HSB(195,50,50)>
				, <&macro_wait_time 120>
				, <&macro_tap &rgb_ug RGB_ON &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_OFF>
				, <&macro_pause_for_release>
				, <&macro_release &mo 3>
				;
		};
		mic_test: mic_test {
			compatible = "zmk,behavior-macro";
			label = "MIC_TEST";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_tap &kp F20 &rgb_ug RGB_EFS_CMD 0 &rgb_ug RGB_COLOR_HSB(330,50,50)>
				, <&macro_wait_time 120>
				, <&macro_tap &rgb_ug RGB_ON &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_OFF>
				;
		};
		mon_test: mon_test {
			compatible = "zmk,behavior-macro";
			label = "MON_TEST";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_tap &kp F18 &rgb_ug RGB_EFS_CMD 1 &rgb_ug RGB_COLOR_HSB(0,0,50) &rgb_ug RGB_ON>
				, <&macro_wait_time 4000>
				, <&macro_tap &rgb_ug RGB_OFF>
				, <&macro_wait_time 0>
				, <&macro_tap &rgb_ug RGB_EFS_CMD 0>
				;
		};
		rainbow: rainbow {
			compatible = "zmk,behavior-macro";
			label = "RAINBOW";
			#binding-cells = <0>;
			wait-ms = <0>;
			tap-ms = <10>;
			bindings
				= <&macro_tap &rgb_ug RGB_EFS_CMD 2 &rgb_ug RGB_ON>
				, <&macro_wait_time 3000>
				, <&macro_tap &rgb_ug RGB_OFF>
				, <&macro_wait_time 0>
				, <&macro_tap &rgb_ug RGB_EFS_CMD 0>
				;
		};
	};

	combos {
		compatible = "zmk,combos";
		combo_all {
			timeout-ms = <100>;
			key-positions = <0 1 2>;
			bindings = <&ht_all 0 0>;
		};
	};

	conditional_layers {
		compatible = "zmk,conditional-layers";
		left_and_right {
			if-layers = <1 3>;
			then-layer = <4>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		base {
			// tap: PREV | PLAY/PAUSE | NEXT; hold: layers 1, 2, 3
			bindings = <&ht_l 0 C_PREV &ht_m 0 C_PP &ht_r 0 C_NEXT>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
		};
		left_held {
			// wheel: Page Up/Down at 4 a turn (stands in for PaperWM windows)
			bindings = <&trans &trans &trans>;
			sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
		};
		middle_held {
			// left: mic mute (F20) + pink; right: F18 + white breathing 4 s; wheel: undo/redo
			bindings = <&mic_test &trans &mon_test>;
			sensor-bindings = <&inc_dec_kp LC(LS(Z)) LC(Z)>;
		};
		right_held {
			// wheel: arrows up/down at 16 a turn
			bindings = <&trans &trans &trans>;
			sensor-bindings = <&scroll_fast UP DOWN>;
		};
		left_and_right_held {
			// wheel: arrows left/right at 16 a turn
			bindings = <&trans &trans &trans>;
			sensor-bindings = <&scroll_fast RIGHT LEFT>;
		};
	};
};
